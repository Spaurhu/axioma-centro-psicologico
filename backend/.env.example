# Configuración de Entorno - Backend NestJS
PORT=4000
NODE_ENV=development

# Cadena de conexión PostgreSQL (Ajustar usuario, contraseña y base de datos)
# Ejemplo con usuario postgres local:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/axioma_psicologia_db?schema=public"

# Clave secreta para generación de tokens JWT
JWT_SECRET="axioma_super_secret_jwt_key_2026_seguro"
JWT_EXPIRES_IN="7d"

# Frontend URL permitida para CORS
FRONTEND_URL="http://localhost:3000"
